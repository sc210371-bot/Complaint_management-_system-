async function getCoins() {
        try {
            const response = await fetch(
                "https://api.coingecko.com/api/v3/coins/markets?vs_currency=usd&order=market_cap_desc&per_page=10&page=1"
            );

            if (!response.ok) {
                throw new Error("Failed to fetch cryptocurrency data");
            }

            const data = await response.json();

            const table = document.getElementById("cryptoList");

            table.innerHTML = "";

            data.slice(0, 10).forEach(function (coin) {

                const priceChange = coin.price_change_percentage_24h;

                const changeClass =
                    priceChange >= 0 ? "green" : "red";

                const changeIcon =
                    priceChange >= 0 ? "▲" : "▼";

                table.innerHTML += `
                    <tr>
                        <td>
                            <img 
                                src="${coin.image}" 
                                alt="${coin.name}"
                                width="30"
                                height="30"
                            >
                            ${coin.name}
                            <small>(${coin.symbol.toUpperCase()})</small>
                        </td>

                        <td>
                            $${coin.current_price.toLocaleString()}
                        </td>

                        <td class="${changeClass}">
                            ${changeIcon}
                            ${priceChange?.toFixed(2) ?? "0.00"}%
                        </td>

                        <td>
                            $${coin.market_cap.toLocaleString()}
                        </td>
                    </tr>
                `;
            });

        } catch (error) {

            document.getElementById("cryptoList").innerHTML =
                "<tr><td colspan='4'>Unable to load cryptocurrency data</td></tr>";

            console.error(error);
        }
    }

    // Load coins when page opens
    getCoins();

    // Refresh every 60 seconds
    setInterval(getCoins, 60000);